---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import NostrContactSection from "@components/sections/misc/NostrContactSection.astro";
import { SITE } from "@data/constants";

const pageTitle: string = `Contact | ${SITE.title}`;
const metaDescription =
  "Have questions or want to discuss a project? Reach out, and let's craft the perfect solution with our tools and services.";
const ogTitle = "Contact Us | Angor";
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://angor.blog/contact",
    url: "https://angor.blog/contact",
    name: "Contact Us | Angor",
    description:
      "Have questions or want to discuss a project? Reach out, and let's craft the perfect solution with our tools and services.",
    isPartOf: {
      "@type": "WebSite",
      url: "https://angor.blog",
      name: "Angor",
      description:
        "Angor offers top-tier decentralized technology tools and expert services to meet all your project needs.",
    },
    inLanguage: "en-US",
  }}
>
  <NostrContactSection />
</MainLayout>
