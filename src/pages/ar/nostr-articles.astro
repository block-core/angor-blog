---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import { SITE } from "@data/constants";

// Mock Nostr articles data for UI testing
const nostrArticles = [
  {
    id: "nostr-article-1",
    title: "البدء مع بروتوكول نوستر",
    description: "دليل شامل لفهم بروتوكول نوستر وكيف يقوم بثورة في وسائل التواصل الاجتماعي اللامركزية. تعلم الأساسيات والمفاهيم الرئيسية ولماذا نوستر مهم لمستقبل الاتصال المقاوم للرقابة.",
    content: "نوستر (الملاحظات وأشياء أخرى منقولة عبر المرحلات) هو بروتوكول بسيط ومفتوح يمكن شبكة اجتماعية عالمية مقاومة للرقابة حقاً. على عكس منصات وسائل التواصل الاجتماعي التقليدية، نوستر لا يعتمد على خادم مركزي أو سلطة...",
    author: "فريق أنغور",
    publishedAt: "2024-12-15",
    tags: ["نوستر", "بروتوكول", "لامركزي", "درس"],
    readTime: "8 دقائق",
    npub: "npub1angor5k8x7m2nwq3p4c6v9h8j1l0z3y5r4t6u8i9o0p2a1s3d4f5g6",
    eventId: "note1angor5k8x7m2nwq3p4c6v9h8j1l0z3y5r4t6u8i9o0p2a1s3d4f5g6h7j8",
    relays: ["wss://relay.angor.io", "wss://relay.damus.io", "wss://nos.lol"]
  },
  {
    id: "nostr-article-2", 
    title: "بناء التطبيقات اللامركزية على نوستر",
    description: "استكشف كيف يمكن للمطورين بناء تطبيقات لامركزية قوية باستخدام بروتوكول نوستر. من الملاحظات الأساسية إلى التطبيقات المعقدة، اكتشف إمكانيات التطوير المقاوم للرقابة.",
    content: "بروتوكول نوستر يفتح إمكانيات لا نهائية لبناء التطبيقات اللامركزية. على عكس تطبيقات الويب التقليدية التي تعتمد على خوادم مركزية، تطبيقات نوستر يمكن أن تعمل عبر شبكة من المرحلات...",
    author: "مجتمع المطورين",
    publishedAt: "2024-12-10",
    tags: ["نوستر", "تطوير", "تطبيقات-لامركزية", "برمجة"],
    readTime: "12 دقيقة",
    npub: "npub1devcom8h3k2m7n9p6q4w5e8r7t2y1u6i9o3p8a5s2d4f7g1h9j6k3",
    eventId: "note1angor8h3k2m7n9p6q4w5e8r7t2y1u6i9o3p8a5s2d4f7g1h9j6k3l8m2",
    relays: ["wss://relay.angor.io", "wss://relay.snort.social", "wss://relay.damus.io"]
  }
];
---

<MainLayout
  title={`مقالات نوستر | ${SITE.title}`}
  description="المقالات المنشورة من قبل أنغور على شبكة نوستر يتم مشاركتها هنا أيضاً. استكشف وسائل التواصل الاجتماعي اللامركزية والاتصال المقاوم للرقابة."
  lang="ar"
  dir="rtl"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://angor.blog/ar/nostr-articles",
    "url": "https://angor.blog/ar/nostr-articles", 
    "name": "مقالات نوستر | مدونة أنغور",
    "description": "المقالات المنشورة من قبل أنغور على شبكة نوستر يتم مشاركتها هنا أيضاً. استكشف وسائل التواصل الاجتماعي اللامركزية والاتصال المقاوم للرقابة.",
    "isPartOf": {
      "@type": "WebSite",
      "url": "https://angor.blog",
      "name": "مدونة أنغور"
    },
    "inLanguage": "ar"
  }}
>
  <!-- Hero Section -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-neutral-900 dark:text-white sm:text-6xl">
          مقالات نوستر
        </h1>
        <p class="mt-6 text-lg leading-8 text-neutral-600 dark:text-neutral-400">
          المقالات المنشورة من قبل أنغور على شبكة نوستر يتم مشاركتها هنا أيضاً. 
          استكشف وسائل التواصل الاجتماعي اللامركزية والاتصال المقاوم للرقابة.
        </p>
      </div>
    </div>
  </section>
  <!-- Nostr Articles Grid -->
  <section class="py-16 bg-neutral-50 dark:bg-neutral-900 rounded-2xl">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
        {nostrArticles.map((article) => (
          <article class="group bg-white dark:bg-neutral-800 rounded-2xl shadow-lg border border-neutral-200 dark:border-neutral-700 overflow-hidden hover:shadow-xl hover:scale-105 transition-all duration-300">
            <!-- Article Header -->
            <div class="p-8 pb-6">
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center space-x-2 space-x-reverse">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-[#086c81]/10 text-[#086c81] dark:bg-[#cbdde1]/10 dark:text-[#cbdde1]">
                    نوستر
                  </span>
                  <span class="text-sm text-neutral-500 dark:text-neutral-400">
                    قراءة {article.readTime}
                  </span>
                </div>
                <time class="text-sm text-neutral-500 dark:text-neutral-400">
                  {new Date(article.publishedAt).toLocaleDateString("ar-SA", { 
                    year: "numeric", 
                    month: "short", 
                    day: "numeric" 
                  })}
                </time>
              </div>
              
              <h2 class="text-2xl font-semibold text-neutral-900 dark:text-white mb-4 group-hover:text-[#086c81] dark:group-hover:text-[#cbdde1] transition-colors duration-200">
                {article.title}
              </h2>
              
              <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-6">
                {article.description}
              </p>

              <!-- Tags -->
              <div class="flex flex-wrap gap-2 mb-6">
                {article.tags.map((tag) => (
                  <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-neutral-100 text-neutral-700 dark:bg-neutral-700 dark:text-neutral-300">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Nostr Metadata -->
            <div class="px-8 py-6 bg-neutral-50 dark:bg-neutral-800/50 border-t border-neutral-200 dark:border-neutral-700">
              <div class="space-y-3">
                <!-- Author -->
                <div class="flex items-center justify-between">
                  <span class="text-sm text-neutral-600 dark:text-neutral-400">المؤلف:</span>
                  <span class="text-sm font-medium text-neutral-900 dark:text-white">{article.author}</span>
                </div>
                
                <!-- Nostr Event ID -->
                <div class="flex items-center justify-between">
                  <span class="text-sm text-neutral-600 dark:text-neutral-400">معرف الحدث:</span>
                  <code class="text-xs font-mono text-[#086c81] dark:text-[#cbdde1] bg-neutral-100 dark:bg-neutral-700 px-2 py-1 rounded">
                    {article.eventId}
                  </code>
                </div>
                
                <!-- Relays -->
                <div class="flex flex-col space-y-1">
                  <span class="text-sm text-neutral-600 dark:text-neutral-400">منشورة على المرحلات:</span>
                  <div class="flex flex-wrap gap-1">
                    {article.relays.map((relay) => (
                      <code class="text-xs font-mono text-neutral-700 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-700 px-2 py-1 rounded">
                        {relay}
                      </code>
                    ))}
                  </div>
                </div>
              </div>
              
              <!-- Read on Nostr Button -->
              <div class="mt-6">
                <button class="w-full inline-flex items-center justify-center px-4 py-2 bg-[#086c81] hover:bg-[#022229] text-white text-sm font-medium rounded-lg transition-colors duration-200">
                  <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                  اقرأ على نوستر
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>  </section>

  <!-- About Nostr Section -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <h2 class="text-3xl font-light text-neutral-900 dark:text-white mb-6">
          ما هو نوستر؟
        </h2>
        <p class="text-lg text-neutral-600 dark:text-neutral-400 mb-8">
          نوستر (الملاحظات وأشياء أخرى منقولة عبر المرحلات) هو بروتوكول بسيط ومفتوح يمكن 
          شبكة اجتماعية عالمية مقاومة للرقابة حقاً. هذه المقالات منشورة أصلاً من قبل 
          آنغور على شبكة نوستر ويتم مشاركتها هنا أيضاً لإمكانية وصول أوسع.
        </p>
        <div class="flex items-center justify-center gap-x-6">
          <a 
            href="https://nostr.com" 
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-6 py-3 bg-[#086c81] hover:bg-[#022229] text-white text-sm font-medium rounded-lg transition-colors duration-200"
          >
            تعلم المزيد عن نوستر
            <svg class="mr-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
          <a 
            href="/ar/contact" 
            class="text-base font-medium text-neutral-900 dark:text-white hover:text-[#086c81] dark:hover:text-[#cbdde1] transition-colors duration-200"
          >
            تواصل معنا →
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
