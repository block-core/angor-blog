---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import { SITE } from "@data/constants";
import NostrArticlesClient from "@/components/NostrArticlesClient.astro";
---

<MainLayout
  lang="ar"
  dir="rtl"
  title={`مقالات نوستر | ${SITE.title}`}
  description="المقالات المنشورة من قبل Angor على شبكة نوستر. استكشف وسائل التواصل الاجتماعي اللامركزية، والتواصل المقاوم للرقابة، ومستقبل البروتوكولات المفتوحة."
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://angor.blog/nostr-articles",
    "url": "https://angor.blog/nostr-articles", 
    "name": "مقالات نوستر | مدونة Angor",
    "description": "المقالات المنشورة من قبل Angor على شبكة نوستر. استكشف وسائل التواصل الاجتماعي اللامركزية والتواصل المقاوم للرقابة.",
    "isPartOf": {
      "@type": "WebSite",
      "url": "https://angor.blog",
      "name": "مدونة Angor"
    }
  }}
>
  <!-- Page Header -->
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <h1 class="text-4xl font-light tracking-tight text-neutral-900 dark:text-white sm:text-6xl">
          مقالات 
          <span class="text-[#086c81] dark:text-[#cbdde1] font-normal">نوستر</span>
        </h1>
        <p class="mt-6 text-xl text-neutral-600 dark:text-neutral-400 max-w-3xl mx-auto">
          المقالات المنشورة من قبل Angor على شبكة نوستر. استكشف وسائل التواصل الاجتماعي اللامركزية، والتواصل المقاوم للرقابة، ومستقبل البروتوكولات المفتوحة.
        </p>
      </div>
    </div>
  </section>

  <!-- Client-side Nostr Articles Component -->
  <NostrArticlesClient />

  <!-- About Nostr Section -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <h2 class="text-3xl font-light text-neutral-900 dark:text-white mb-6">
          ما هو نوستر؟
        </h2>
        <p class="text-lg text-neutral-600 dark:text-neutral-400 mb-8">
          نوستر (الملاحظات وأشياء أخرى منقولة بواسطة المرحلات) هو بروتوكول بسيط ومفتوح يمكّن 
          من إنشاء شبكة اجتماعية مقاومة حقاً للرقابة وعالمية. هذه المقالات منشورة أصلاً من قبل 
          Angor على شبكة نوستر وتُشارك هنا أيضاً لإمكانية وصول أوسع.
        </p>
        <div class="flex items-center justify-center gap-x-6">
          <a 
            href="https://nostr.com" 
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-6 py-3 bg-[#086c81] hover:bg-[#022229] text-white text-sm font-medium rounded-lg transition-colors duration-200"
          >
            تعرف على المزيد حول نوستر
            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
