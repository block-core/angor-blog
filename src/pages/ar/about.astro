---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import AboutSection from "@components/sections/ar/AboutSection_ar.astro";
import { SITE } from "@data/constants";

const pageTitle: string = `حول Angor | ${SITE.title}`;
const metaDescription =
  "تعرف على Angor، بروتوكول التمويل الجماعي اللامركزي الذي يحول طريقة تمويل المشاريع باستخدام شبكة البيتكوين وبروتوكول نوستر مع الأمان وعدم الحاجة للثقة والشفافية.";
const ogTitle = "حول Angor | Angor";
---

<MainLayout
  title={pageTitle}
  lang="ar"
  dir="rtl"
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://angor.blog/ar/about",
    url: "https://angor.blog/ar/about",
    name: "حول Angor | Angor",
    description: metaDescription,
    isPartOf: {
      "@type": "WebSite",
      url: "https://angor.blog/ar/",
      name: "Angor",
      description:
        "Angor يقدم أدوات وخدمات التقنيات اللامركزية عالية المستوى لتلبية جميع احتياجات مشاريعك.",
    },
    inLanguage: "ar",
  }}
>
  <AboutSection />
</MainLayout>
