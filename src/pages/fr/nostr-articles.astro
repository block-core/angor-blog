---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import { SITE } from "@data/constants";
import NostrArticlesClient from "@/components/NostrArticlesClient.astro";
---

<MainLayout
  title={`Articles Nostr | ${SITE.title}`}
  description="Articles publiés par Angor sur le réseau Nostr. Explorez les médias sociaux décentralisés, la communication résistante à la censure et l'avenir des protocoles ouverts."
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://angor.blog/fr/nostr-articles",
    "url": "https://angor.blog/fr/nostr-articles", 
    "name": "Articles Nostr | Angor Blog",
    "description": "Articles publiés par Angor sur le réseau Nostr. Explorez les médias sociaux décentralisés et la communication résistante à la censure.",
    "isPartOf": {
      "@type": "WebSite",
      "url": "https://angor.blog",
      "name": "Angor Blog"
    }
  }}
>
  <!-- Page Header -->
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <h1 class="text-4xl font-light tracking-tight text-neutral-900 dark:text-white sm:text-6xl">
          Articles 
          <span class="text-[#086c81] dark:text-[#cbdde1] font-normal">Angor</span>
        </h1>
        <p class="mt-6 text-xl text-neutral-600 dark:text-neutral-400 max-w-3xl mx-auto">
          Articles publiés par Angor sur le réseau Nostr. Explorez les médias sociaux décentralisés, la communication résistante à la censure et l'avenir des protocoles ouverts.
        </p>
      </div>
    </div>
  </section>

  <!-- Client-side Angor Articles Component -->
  <NostrArticlesClient />

  <!-- About Nostr Section -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <h2 class="text-3xl font-light text-neutral-900 dark:text-white mb-6">
          Qu'est-ce que Nostr ?
        </h2>
        <p class="text-lg text-neutral-600 dark:text-neutral-400 mb-8">
          Nostr (Notes et Autres Trucs Transmis par des Relais) est un protocole simple et ouvert qui permet 
          un réseau social véritablement résistant à la censure et global. Ces articles sont originalement publiés 
          par Angor sur le réseau Nostr et sont également partagés ici pour une accessibilité plus large.
        </p>
        <div class="flex items-center justify-center gap-x-6">
          <a 
            href="https://nostr.com" 
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-6 py-3 bg-[#086c81] hover:bg-[#022229] text-white text-sm font-medium rounded-lg transition-colors duration-200"
          >
            En savoir plus sur Nostr
            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
