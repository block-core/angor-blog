---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import { getCollection } from "astro:content";

// Get the latest 3 blog posts dynamically
const allBlogPosts = await getCollection("blog");
const latestPosts = allBlogPosts
  .filter(post => post.id.startsWith("fr/")) // Only French posts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);
---

<MainLayout
  title="Bienvenue sur Angor | Blog"
  description="Découvrez des insights sur la finance décentralisée, la technologie blockchain et l'avenir des actifs numériques. Lisez nos derniers articles et explorez le contenu publié sur le réseau Nostr."
  lang="fr"
>
  <!-- Hero Section -->
  <section class="py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <!-- Main Heading -->
        <h1 class="text-5xl font-light tracking-tight text-neutral-900 dark:text-white sm:text-7xl">
          Bienvenue sur 
          <span class="text-[#086c81] dark:text-[#cbdde1] font-normal">Angor Blog</span>
        </h1>
        
        <!-- Description -->
        <p class="mt-8 text-xl leading-relaxed text-neutral-600 dark:text-neutral-400 max-w-3xl mx-auto">
          Découvrez des insights sur la finance décentralisée, la technologie blockchain et l'avenir des actifs numériques. 
          Lisez nos derniers articles et explorez le contenu publié sur le réseau Nostr.
        </p>

        <!-- CTA Buttons -->
        <div class="mt-12 flex items-center justify-center gap-x-8">
          <a 
            href="/fr/blog" 
            class="rounded-lg bg-[#086c81] px-8 py-4 text-base font-medium text-white hover:bg-[#022229] transition-colors duration-200"
          >
            Lire le Blog
          </a>
          <a 
            href="/fr/nostr-articles" 
            class="text-base font-medium text-neutral-900 dark:text-white hover:text-[#086c81] dark:hover:text-[#cbdde1] transition-colors duration-200"
          >
            Articles Nostr →
          </a>
        </div>

        <!-- Blog Stats -->
        <div class="mt-20 grid grid-cols-1 gap-12 sm:grid-cols-3">
          <div class="text-center">
            <div class="text-4xl font-light text-neutral-900 dark:text-white">{allBlogPosts.length}</div>
            <div class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">Total Articles</div>
          </div>
          <div class="text-center">
            <div class="text-4xl font-light text-neutral-900 dark:text-white">{allBlogPosts.filter(post => post.id.startsWith("fr/")).length}</div>
            <div class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">Articles Français</div>
          </div>
          <div class="text-center">
            <div class="text-4xl font-light text-neutral-900 dark:text-white">{allBlogPosts.filter(post => post.id.startsWith("en/")).length}</div>
            <div class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">Articles Anglais</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Blog Posts Section -->
  <section class="py-10 bg-neutral-50 dark:bg-neutral-900 rounded-2xl">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <!-- Section Header -->
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="text-4xl font-light text-neutral-900 dark:text-white">
          Derniers Articles du Blog
        </h2>
        <p class="mt-6 text-lg text-neutral-600 dark:text-neutral-400">
          Restez à jour avec les derniers insights, tutoriels et nouvelles de l'écosystème Angor.
        </p>
      </div>

      <!-- Blog Posts Grid -->
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
        {latestPosts.map((post) => (
          <article class="group bg-white/50 dark:bg-neutral-800/50 backdrop-blur-sm rounded-2xl shadow-lg border border-neutral-200/50 dark:border-neutral-700/50 overflow-hidden hover:shadow-xl hover:scale-105 transition-all duration-300">
            <!-- Blog Post Image -->
            <div class="aspect-video overflow-hidden">
              <img 
                src={post.data.cardImage.src} 
                alt={post.data.cardImageAlt} 
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
              />
            </div>
            <div class="p-8">
              <div class="flex items-center justify-between mb-6">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-[#086c81]/10 text-[#086c81] dark:bg-[#cbdde1]/10 dark:text-[#cbdde1]">
                  {post.data.tags?.[0] || "Blog"}
                </span>
                <time class="text-sm text-neutral-500 dark:text-neutral-400">
                  {new Date(post.data.pubDate).toLocaleDateString("fr-FR", { 
                    year: "numeric", 
                    month: "short", 
                    day: "numeric" 
                  })}
                </time>
              </div>
              <h3 class="text-xl font-semibold text-neutral-900 dark:text-white mb-4 group-hover:text-[#086c81] dark:group-hover:text-[#cbdde1] transition-colors duration-200">
                <a href={`/fr/blog/${post.id.replace('fr/', '')}`}>
                  {post.data.title}
                </a>
              </h3>
              <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-6 line-clamp-3">
                {post.data.description}
              </p>
              <div class="flex items-center justify-between">
                <a 
                  href={`/fr/blog/${post.id.replace('fr/', '')}`}
                  class="inline-flex items-center text-sm font-semibold text-[#086c81] dark:text-[#cbdde1] hover:text-[#022229] dark:hover:text-white transition-colors duration-200"
                >
                  Lire la suite 
                  <svg class="ml-1 w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </a>
                <span class="text-xs text-neutral-500 dark:text-neutral-400">
                  {post.data.readTime} min de lecture
                </span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- View All Blog Posts Button -->
      <div class="mt-16 text-center">
        <a 
          href="/fr/blog" 
          class="inline-flex items-center justify-center rounded-lg bg-[#086c81] px-8 py-4 text-base font-medium text-white hover:bg-[#022229] transition-colors duration-200"
        >
          Voir Tous les Articles
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-4xl font-light text-neutral-900 dark:text-white">
          Prêt à commencer votre aventure DeFi ?
        </h2>
        <p class="mt-6 text-lg text-neutral-600 dark:text-neutral-400">
          Rejoignez des milliers d'utilisateurs qui font confiance à Angor pour leurs besoins de finance décentralisée.
        </p>
        <div class="mt-10 flex items-center justify-center gap-x-8">
          <a 
            href="/docs" 
            class="rounded-lg bg-[#086c81] px-8 py-4 text-base font-medium text-white hover:bg-[#022229] transition-colors duration-200"
          >
            Commencer Maintenant
          </a>
          <a 
            href="/fr/contact" 
            class="text-base font-medium text-neutral-900 dark:text-white hover:text-[#086c81] dark:hover:text-[#cbdde1] transition-colors duration-200"
          >
            Nous Contacter →
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
