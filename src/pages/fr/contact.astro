---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import NostrContactSection from "@components/sections/fr/NostrContactSection_fr.astro";
import { SITE } from "@data/constants";

const pageTitle: string = `Nous Contacter | ${SITE.title}`;
const metaDescription =
  "Vous avez des questions ou souhaitez discuter d'un projet ? Contactez-nous et élaborons ensemble la solution parfaite avec nos outils et services.";
const ogTitle = "Nous Contacter | Angor";
---

<MainLayout
  title={pageTitle}
  lang="fr"
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://angor.blog/fr/contact",
    url: "https://angor.blog/fr/contact",
    name: "Nous Contacter | Angor",
    description:
      "Vous avez des questions ou souhaitez discuter d'un projet ? Contactez-nous et élaborons ensemble la solution parfaite avec nos outils et services.",
    isPartOf: {
      "@type": "WebSite",
      url: "https://angor.blog/fr/",
      name: "Angor",
      description:
        "Angor propose des outils et services de technologies décentralisées de premier ordre pour répondre à tous vos besoins de projet.",
    },
    inLanguage: "fr",
  }}
>
  <NostrContactSection />
</MainLayout>
