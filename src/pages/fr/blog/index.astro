---
// Import necessary components, modules and types
import MainLayout from "@/layouts/MainLayout.astro";
import BlogCardProfessional from "@components/ui/cards/BlogCardProfessional.astro";
import BlogSearch from "@components/ui/search/BlogSearch.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { SITE } from "@data/constants";
import { getTranslation } from "@utils/translations";

// Get all blogs post in French and sort them based on publish date

const frenchBlogEntries = await getCollection("blog", ({ id }) => {
  return id.startsWith("fr/");
});

const blogPosts: CollectionEntry<"blog">[] = frenchBlogEntries.sort(
  (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Define variables for page content
const title: string = "Blog Angor";
const subTitle: string = "Dernières analyses sur Bitcoin, Nostr et les technologies décentralisées.";

const pageTitle: string = `Blog | ${SITE.title}`;
const metaDescription =
  "Restez informé des dernières tendances et évolutions dans les technologies décentralisées avec les analyses de l'équipe d'experts d'Angor.";
const ogTitle = "Blog Technologie Décentralisée | Angor";

// Get localized text
const latestArticlesText = getTranslation("fr", "latest_articles");
const discoverPostsText = getTranslation("fr", "discover_posts");
---

<MainLayout
  lang="fr"
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://blog.angor.io/fr/blog",
    url: "https://blog.angor.io/fr/blog",
    name: "Blog | Angor",
    description: metaDescription,
    isPartOf: {
      "@type": "WebSite",
      url: "https://blog.angor.io/fr",
      name: "Angor",
      description:
        "Angor offre des outils de technologie décentralisée de premier niveau et des services experts pour répondre à tous vos besoins de projet.",
    },
    inLanguage: "fr",
  }}
>
 <section
    class="mx-auto max-w-[85rem] space-y-8 px-4 pt-16 sm:px-6 lg:px-8 2xl:max-w-full"
  >
    {/* Page header */}
    <div class="mx-auto max-w-3xl text-center sm:text-center">
      <h1
        class="block text-4xl font-bold tracking-tight text-balance text-neutral-800 md:text-5xl lg:text-6xl dark:text-neutral-200"
      >
        {title}
      </h1>

      <p
        class="mt-4 text-lg text-pretty text-neutral-600 dark:text-neutral-400"
      >
        {subTitle}
      </p>
    </div>
    
    {/* Search Component */}
    <div class="mx-auto max-w-3xl">
      <BlogSearch locale="fr" />
    </div>
  </section>
  {/* All Posts Grid */}
  {blogPosts.length > 0 && (
    <section
      class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
    >
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-neutral-800 dark:text-neutral-200 lg:text-3xl">
          {latestArticlesText}
        </h2>
        <p class="mt-2 text-neutral-600 dark:text-neutral-400">
          {discoverPostsText}
        </p>
      </div>
        {/* 3-Column Responsive Grid */}
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {blogPosts.map((blogEntry) => (
          <BlogCardProfessional blogEntry={blogEntry} locale="en" />
        ))}
      </div>
    </section>
  )}

  {/* RSS Feed Section */}
  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 2xl:max-w-full"
  >
    <div class="text-center border-t border-neutral-300 dark:border-neutral-700 pt-8">
      <h3 class="text-lg font-semibold text-neutral-800 dark:text-neutral-200 mb-4">
        S'abonner aux mises à jour du blog
      </h3>
      <p class="text-neutral-600 dark:text-neutral-400 mb-6">
        Recevez les derniers articles et mises à jour directement dans votre lecteur de flux favori
      </p>
      <a
        href="/fr/rss.xml"
        class="inline-flex items-center gap-2 px-6 py-3 bg-orange-500 hover:bg-orange-600  text-neutral-800 dark:text-neutral-200 font-medium rounded-lg transition-colors duration-200"
        target="_blank"
        rel="noopener noreferrer"
      >
 <svg
          class="h-5 w-5"
          version="1.1"
          id="Layer_1"
          xmlns="http://www.w3.org/2000/svg"
          xmlns:xlink="http://www.w3.org/1999/xlink"
          viewBox="0 0 512 512"
          xml:space="preserve"
        >
          <g>
            <path
              style="fill:#D5851F;"
              d="M149.047,437.393c0-40.825-33.206-74.039-74.02-74.039c-40.82,0-74.029,33.214-74.029,74.039
		c0,40.818,33.209,74.025,74.029,74.025C115.842,511.419,149.047,478.211,149.047,437.393z"
            ></path>
            <path
              style="fill:#D5851F;"
              d="M9.327,279.833c59.394,0,115.253,23.232,157.285,65.412c42.034,42.253,65.184,98.515,65.184,158.423
		c0,4.562,3.696,8.258,8.258,8.258h94.945c4.562,0,8.258-3.696,8.258-8.258c0-184.901-149.8-335.329-333.931-335.329
		c-4.562,0-8.258,3.696-8.258,8.258v94.976C1.069,276.135,4.767,279.833,9.327,279.833z"
            ></path>
            <path
              style="fill:#D5851F;"
              d="M9.456,0C4.895,0,1.198,3.696,1.198,8.258v94.959c0,4.562,3.696,8.258,8.258,8.258
		c215.106,0,390.109,175.969,390.109,392.266c0,4.562,3.696,8.258,8.258,8.258h94.92c4.562,0,8.258-3.696,8.258-8.258
		C511.002,225.977,286.009,0,9.456,0z"
            ></path>
          </g>
        </svg>
        Flux RSS
      </a>
    </div>
  </section>

  {/* Empty State */}
  {blogPosts.length === 0 && (
    <section
      class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
    >
      <div class="text-center py-12">
        <h3 class="text-2xl font-semibold text-neutral-800 dark:text-neutral-200">
          Coming Soon
        </h3>
        <p class="mt-3 text-neutral-600 dark:text-neutral-400">
          We're working on adding more content. Stay tuned for updates.
        </p>
      </div>
    </section>
  )}
</MainLayout>
