---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import AboutSection from "@components/sections/misc/AboutSection.astro";
import { SITE } from "@data/constants";

const pageTitle: string = `About Angor | ${SITE.title}`;
const metaDescription =
  "Learn about Angor, a decentralized crowdfunding protocol that transforms project funding using Bitcoin network and Nostr protocol with security, trustlessness, and transparency.";
const ogTitle = "About Angor | Angor";
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://angor.blog/about",
    url: "https://angor.blog/about",
    name: "About Angor | Angor",
    description: metaDescription,
    isPartOf: {
      "@type": "WebSite",
      url: "https://angor.blog",
      name: "Angor",
      description:
        "Angor offers top-tier decentralized technology tools and expert services to meet all your project needs.",
    },
    inLanguage: "en-US",
  }}
>
  <AboutSection />
</MainLayout>
