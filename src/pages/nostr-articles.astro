---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import { SITE } from "@data/constants";
import NostrArticlesClient from "@/components/NostrArticlesClient.astro";
---

<MainLayout
  title={`Nostr Articles | ${SITE.title}`}
  description="Articles published by Angor on the Nostr network. Explore decentralized social media, censorship-resistant communication, and the future of open protocols."
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://angor.blog/nostr-articles",
    "url": "https://angor.blog/nostr-articles", 
    "name": "Nostr Articles | Angor Blog",
    "description": "Articles published by Angor on the Nostr network. Explore decentralized social media and censorship-resistant communication.",
    "isPartOf": {
      "@type": "WebSite",
      "url": "https://angor.blog",
      "name": "Angor Blog"
    }
  }}
>
  <!-- Page Header -->
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <h1 class="text-4xl font-light tracking-tight text-neutral-900 dark:text-white sm:text-6xl">
          Nostr 
          <span class="text-[#086c81] dark:text-[#cbdde1] font-normal">Articles</span>
        </h1>
        <p class="mt-6 text-xl text-neutral-600 dark:text-neutral-400 max-w-3xl mx-auto">
          Articles published by Angor on the Nostr network. Explore decentralized social media, censorship-resistant communication, and the future of open protocols.
        </p>
      </div>
    </div>
  </section>

  <!-- Client-side Nostr Articles Component -->
  <NostrArticlesClient />

  <!-- About Nostr Section -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <h2 class="text-3xl font-light text-neutral-900 dark:text-white mb-6">
          What is Nostr?
        </h2>
        <p class="text-lg text-neutral-600 dark:text-neutral-400 mb-8">
          Nostr (Notes and Other Stuff Transmitted by Relays) is a simple, open protocol that enables 
          a truly censorship-resistant and global social network. These articles are originally published 
          by Angor on the Nostr network and are also shared here for broader accessibility.
        </p>
        <div class="flex items-center justify-center gap-x-6">
          <a 
            href="https://nostr.com" 
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-6 py-3 bg-[#086c81] hover:bg-[#022229] text-white text-sm font-medium rounded-lg transition-colors duration-200"
          >
            Learn More About Nostr
            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
