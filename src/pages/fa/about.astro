---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import AboutSection from "@components/sections/fa/AboutSection_fa.astro";
import { SITE } from "@data/constants";

const pageTitle: string = `درباره آنگور | ${SITE.title}`;
const metaDescription =
  "با آنگور آشنا شوید، پروتکل تامین مالی جمعی غیرمتمرکز که روش تامین مالی پروژه‌ها را با استفاده از شبکه بیت‌کوین و پروتکل نوستر با امنیت، بدون نیاز به اعتماد و شفافیت متحول می‌کند.";
const ogTitle = "درباره آنگور | آنگور";
---

<MainLayout
  title={pageTitle}
  lang="fa"
  dir="rtl"
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://angor.blog/fa/about",
    url: "https://angor.blog/fa/about",
    name: "درباره آنگور | آنگور",
    description: metaDescription,
    isPartOf: {
      "@type": "WebSite",
      url: "https://angor.blog/fa/",
      name: "آنگور",
      description:
        "آنگور ابزارها و خدمات فناوری‌های غیرمتمرکز درجه یک را برای تأمین تمام نیازهای پروژه‌های شما ارائه می‌دهد.",
    },
    inLanguage: "fa",
  }}
>
  <AboutSection />
</MainLayout>
