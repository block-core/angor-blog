---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import { SITE } from "@data/constants";
import NostrArticlesClient from "@/components/NostrArticlesClient.astro";
---

<MainLayout
  lang="fa"
  dir="rtl"
  title={`مقالات نوستر | ${SITE.title}`}
  description="مقالات منتشر شده توسط آنگور در شبکه نوستر. کاوش در رسانه‌های اجتماعی غیرمتمرکز، ارتباطات مقاوم در برابر سانسور و آینده پروتکل‌های باز."
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://angor.blog/nostr-articles",
    "url": "https://angor.blog/nostr-articles", 
    "name": "مقالات نوستر | وبلاگ آنگور",
    "description": "مقالات منتشر شده توسط آنگور در شبکه نوستر. کاوش در رسانه‌های اجتماعی غیرمتمرکز و ارتباطات مقاوم در برابر سانسور.",
    "isPartOf": {
      "@type": "WebSite",
      "url": "https://angor.blog",
      "name": "وبلاگ آنگور"
    }
  }}
>
  <!-- Page Header -->
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <h1 class="text-4xl font-light tracking-tight text-neutral-900 dark:text-white sm:text-6xl">
          مقالات 
          <span class="text-[#086c81] dark:text-[#cbdde1] font-normal">Angor</span>
        </h1>
        <p class="mt-6 text-xl text-neutral-600 dark:text-neutral-400 max-w-3xl mx-auto">
          مقالات منتشر شده توسط آنگور در شبکه نوستر. کاوش در رسانه‌های اجتماعی غیرمتمرکز، ارتباطات مقاوم در برابر سانسور و آینده پروتکل‌های باز.
        </p>
      </div>
    </div>
  </section>

  <!-- Client-side Angor Articles Component -->
  <NostrArticlesClient />

  <!-- About Nostr Section -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <h2 class="text-3xl font-light text-neutral-900 dark:text-white mb-6">
          نوستر چیست؟
        </h2>
        <p class="text-lg text-neutral-600 dark:text-neutral-400 mb-8">
          نوستر (یادداشت‌ها و چیزهای دیگر منتقل شده توسط رله‌ها) یک پروتکل ساده و باز است که 
          یک شبکه اجتماعی واقعاً مقاوم در برابر سانسور و جهانی را امکان‌پذیر می‌کند. این مقالات در اصل توسط 
          آنگور در شبکه نوستر منتشر شده‌اند و همچنین برای دسترسی گسترده‌تر در اینجا به اشتراک گذاشته شده‌اند.
        </p>
        <div class="flex items-center justify-center gap-x-6">
          <a 
            href="https://nostr.com" 
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-6 py-3 bg-[#086c81] hover:bg-[#022229] text-white text-sm font-medium rounded-lg transition-colors duration-200"
          >
            بیشتر درباره نوستر بدانید
            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
