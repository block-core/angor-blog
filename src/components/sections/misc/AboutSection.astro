---
// Component Imports
import Icon from "@components/ui/icons/Icon.astro";

const title: string = "About Angor";
const subTitle: string = 
  "Transforming project funding through decentralized technology";
---

<!-- About Section -->
<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-4xl">
    <div class="text-center">
      <h1
        class="text-balance text-3xl font-bold tracking-tight text-neutral-800 dark:text-neutral-200 md:text-5xl md:leading-tight"
      >
        {title}
      </h1>
      <p class="mt-4 text-pretty text-lg text-neutral-600 dark:text-neutral-400">
        {subTitle}
      </p>
    </div>

    <div class="mt-12 space-y-8">
      <!-- Main Description -->
      <div class="prose prose-lg mx-auto dark:prose-invert">
        <p class="text-lg leading-relaxed text-neutral-700 dark:text-neutral-300">
          Angor is a decentralized crowdfunding protocol that transforms the way projects are funded by utilizing the Bitcoin network and the Nostr protocol. Designed with security, trustlessness, and transparency in mind, Angor empowers investors, project founders, and developers to interact within a robust decentralized ecosystem.
        </p>
      </div>

      <!-- Key Features -->
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3 mt-16">
        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#086c81]/10 dark:bg-[#cbdde1]/10">
            <Icon name="shield" class="h-8 w-8 text-[#086c81] dark:text-[#cbdde1]" />
          </div>
          <h3 class="mt-4 text-xl font-semibold text-neutral-800 dark:text-neutral-200">
            Security First
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            Built on Bitcoin's robust security model, ensuring your investments and projects are protected by the world's most secure blockchain.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#086c81]/10 dark:bg-[#cbdde1]/10">
            <Icon name="users" class="h-8 w-8 text-[#086c81] dark:text-[#cbdde1]" />
          </div>
          <h3 class="mt-4 text-xl font-semibold text-neutral-800 dark:text-neutral-200">
            Trustless System
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            No need to trust intermediaries. Smart contracts and cryptographic proofs ensure all parties can interact with confidence.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#086c81]/10 dark:bg-[#cbdde1]/10">
            <Icon name="eye" class="h-8 w-8 text-[#086c81] dark:text-[#cbdde1]" />
          </div>
          <h3 class="mt-4 text-xl font-semibold text-neutral-800 dark:text-neutral-200">
            Full Transparency
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            Every transaction and project milestone is visible on the blockchain, providing complete transparency for all stakeholders.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#086c81]/10 dark:bg-[#cbdde1]/10">
            <Icon name="globe" class="h-8 w-8 text-[#086c81] dark:text-[#cbdde1]" />
          </div>
          <h3 class="mt-4 text-xl font-semibold text-neutral-800 dark:text-neutral-200">
            Global Access
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            Accessible from anywhere in the world without geographical restrictions or traditional banking requirements.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#086c81]/10 dark:bg-[#cbdde1]/10">
            <Icon name="lightning" class="h-8 w-8 text-[#086c81] dark:text-[#cbdde1]" />
          </div>
          <h3 class="mt-4 text-xl font-semibold text-neutral-800 dark:text-neutral-200">
            Bitcoin Powered
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            Leverages Bitcoin's network for secure, immutable transactions and value storage without relying on traditional financial systems.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#086c81]/10 dark:bg-[#cbdde1]/10">
            <Icon name="nostr" class="h-8 w-8 text-[#086c81] dark:text-[#cbdde1]" />
          </div>
          <h3 class="mt-4 text-xl font-semibold text-neutral-800 dark:text-neutral-200">
            Nostr Integration
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            Uses the Nostr protocol for decentralized communication, ensuring censorship-resistant project updates and community interaction.
          </p>
        </div>
      </div>

      <!-- Mission Statement -->
      <div class="mt-16 text-center">
        <h2 class="text-2xl font-bold text-neutral-800 dark:text-neutral-200 mb-6">
          Our Mission
        </h2>
        <p class="text-lg leading-relaxed text-neutral-700 dark:text-neutral-300 max-w-3xl mx-auto">
          We believe in democratizing access to funding while eliminating the need for trust between parties. By combining Bitcoin's security with Nostr's communication capabilities, we're building the future of decentralized project funding where innovation can flourish without traditional barriers.
        </p>
      </div>

      <!-- Call to Action -->
      <div class="mt-16 text-center">
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/blog" 
            class="rounded-lg bg-[#086c81] px-8 py-4 text-base font-medium text-white hover:bg-[#022229] transition-colors duration-200"
          >
            Get Started
          </a>
          <a 
            href="/contact" 
            class="rounded-lg border border-neutral-300 dark:border-neutral-600 px-8 py-4 text-base font-medium text-neutral-700 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors duration-200"
          >
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
