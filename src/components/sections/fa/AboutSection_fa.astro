---
// Component Imports
import Icon from "@components/ui/icons/Icon.astro";

const title: string = "درباره Angor";
const subTitle: string = 
  "تبدیل تامین مالی پروژه‌ها از طریق فناوری غیرمتمرکز";
---

<!-- About Section -->
<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14" dir="rtl">
  <div class="mx-auto max-w-4xl">
    <div class="text-center">
      <h1
        class="text-balance text-3xl font-bold tracking-tight text-neutral-800 dark:text-neutral-200 md:text-5xl md:leading-tight"
      >
        {title}
      </h1>
      <p class="mt-4 text-pretty text-lg text-neutral-600 dark:text-neutral-400">
        {subTitle}
      </p>
    </div>

    <div class="mt-12 space-y-8">
      <!-- Main Description -->
      <div class="prose prose-lg mx-auto dark:prose-invert">
        <p class="text-lg leading-relaxed text-neutral-700 dark:text-neutral-300">
          Angor یک پروتکل تامین مالی جمعی غیرمتمرکز است که روش تامین مالی پروژه‌ها را با استفاده از شبکه بیت‌کوین و پروتکل نوستر متحول می‌کند. با در نظر گیری امنیت، عدم نیاز به اعتماد و شفافیت طراحی شده، Angor سرمایه‌گذاران، بنیان‌گذاران پروژه و توسعه‌دهندگان را قادر می‌سازد تا در یک اکوسیستم غیرمتمرکز قوی تعامل داشته باشند.
        </p>
      </div>

      <!-- Key Features -->
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3 mt-16">
        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#086c81]/10 dark:bg-[#cbdde1]/10">
            <Icon name="shield" class="h-8 w-8 text-[#086c81] dark:text-[#cbdde1]" />
          </div>
          <h3 class="mt-4 text-xl font-semibold text-neutral-800 dark:text-neutral-200">
            امنیت در اولویت
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            بر اساس مدل امنیتی قوی بیت‌کوین ساخته شده، تضمین می‌کند که سرمایه‌گذاری‌ها و پروژه‌های شما توسط امن‌ترین بلاک‌چین جهان محافظت می‌شوند.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#086c81]/10 dark:bg-[#cbdde1]/10">
            <Icon name="users" class="h-8 w-8 text-[#086c81] dark:text-[#cbdde1]" />
          </div>
          <h3 class="mt-4 text-xl font-semibold text-neutral-800 dark:text-neutral-200">
            سیستم بدون اعتماد
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            نیازی به اعتماد به واسطه‌ها نیست. قراردادهای هوشمند و اثبات‌های رمزنگاری تضمین می‌کنند که همه طرف‌ها می‌توانند با اطمینان تعامل داشته باشند.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#086c81]/10 dark:bg-[#cbdde1]/10">
            <Icon name="eye" class="h-8 w-8 text-[#086c81] dark:text-[#cbdde1]" />
          </div>
          <h3 class="mt-4 text-xl font-semibold text-neutral-800 dark:text-neutral-200">
            شفافیت کامل
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            هر تراکنش و مرحله پروژه بر روی بلاک‌چین قابل مشاهده است و شفافیت کاملی برای همه ذی‌نفعان فراهم می‌کند.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#086c81]/10 dark:bg-[#cbdde1]/10">
            <Icon name="globe" class="h-8 w-8 text-[#086c81] dark:text-[#cbdde1]" />
          </div>
          <h3 class="mt-4 text-xl font-semibold text-neutral-800 dark:text-neutral-200">
            دسترسی جهانی
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            از هر نقطه از جهان بدون محدودیت‌های جغرافیایی یا نیازمندی‌های بانکی سنتی قابل دسترسی است.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#086c81]/10 dark:bg-[#cbdde1]/10">
            <Icon name="lightning" class="h-8 w-8 text-[#086c81] dark:text-[#cbdde1]" />
          </div>
          <h3 class="mt-4 text-xl font-semibold text-neutral-800 dark:text-neutral-200">
            قدرت گرفته از بیت‌کوین
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            از شبکه بیت‌کوین برای تراکنش‌های امن و تغییرناپذیر و ذخیره‌سازی ارزش بدون اتکا به سیستم‌های مالی سنتی استفاده می‌کند.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#086c81]/10 dark:bg-[#cbdde1]/10">
            <Icon name="nostr" class="h-8 w-8 text-[#086c81] dark:text-[#cbdde1]" />
          </div>
          <h3 class="mt-4 text-xl font-semibold text-neutral-800 dark:text-neutral-200">
            یکپارچگی نوستر
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            از پروتکل نوستر برای ارتباطات غیرمتمرکز استفاده می‌کند و به‌روزرسانی‌های پروژه مقاوم در برابر سانسور و تعامل جامعه را تضمین می‌کند.
          </p>
        </div>
      </div>

      <!-- Mission Statement -->
      <div class="mt-16 text-center">
        <h2 class="text-2xl font-bold text-neutral-800 dark:text-neutral-200 mb-6">
          ماموریت ما
        </h2>
        <p class="text-lg leading-relaxed text-neutral-700 dark:text-neutral-300 max-w-3xl mx-auto">
          ما به دموکراتیزه کردن دسترسی به تامین مالی در حین حذف نیاز به اعتماد بین طرف‌ها اعتقاد داریم. با ترکیب امنیت بیت‌کوین با قابلیت‌های ارتباطی نوستر، ما آینده تامین مالی پروژه‌های غیرمتمرکز را می‌سازیم جایی که نوآوری می‌تواند بدون موانع سنتی شکوفا شود.
        </p>
      </div>

      <!-- Call to Action -->
      <div class="mt-16 text-center">
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/fa/welcome-to-docs/" 
            class="rounded-lg bg-[#086c81] px-8 py-4 text-base font-medium text-white hover:bg-[#022229] transition-colors duration-200"
          >
            شروع کنید
          </a>
          <a 
            href="/fa/contact" 
            class="rounded-lg border border-neutral-300 dark:border-neutral-600 px-8 py-4 text-base font-medium text-neutral-700 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors duration-200"
          >
            تماس با ما
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
