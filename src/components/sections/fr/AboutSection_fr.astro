---
// Component Imports
import Icon from "@components/ui/icons/Icon.astro";

const title: string = "À Propos d'Angor";
const subTitle: string = 
  "Transformer le financement de projets grâce à la technologie décentralisée";
---

<!-- About Section -->
<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-4xl">
    <div class="text-center">
      <h1
        class="text-balance text-3xl font-bold tracking-tight text-neutral-800 dark:text-neutral-200 md:text-5xl md:leading-tight"
      >
        {title}
      </h1>
      <p class="mt-4 text-pretty text-lg text-neutral-600 dark:text-neutral-400">
        {subTitle}
      </p>
    </div>

    <div class="mt-12 space-y-8">
      <!-- Main Description -->
      <div class="prose prose-lg mx-auto dark:prose-invert">
        <p class="text-lg leading-relaxed text-neutral-700 dark:text-neutral-300">
          Angor est un protocole de financement participatif décentralisé qui transforme la façon dont les projets sont financés en utilisant le réseau Bitcoin et le protocole Nostr. Conçu avec la sécurité, l'absence de confiance et la transparence à l'esprit, Angor permet aux investisseurs, aux fondateurs de projets et aux développeurs d'interagir au sein d'un écosystème décentralisé robuste.
        </p>
      </div>

      <!-- Key Features -->
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3 mt-16">
        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#086c81]/10 dark:bg-[#cbdde1]/10">
            <Icon name="shield" class="h-8 w-8 text-[#086c81] dark:text-[#cbdde1]" />
          </div>
          <h3 class="mt-4 text-xl font-semibold text-neutral-800 dark:text-neutral-200">
            Sécurité Avant Tout
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            Construit sur le modèle de sécurité robuste de Bitcoin, garantissant que vos investissements et projets sont protégés par la blockchain la plus sécurisée au monde.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#086c81]/10 dark:bg-[#cbdde1]/10">
            <Icon name="users" class="h-8 w-8 text-[#086c81] dark:text-[#cbdde1]" />
          </div>
          <h3 class="mt-4 text-xl font-semibold text-neutral-800 dark:text-neutral-200">
            Système Sans Confiance
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            Pas besoin de faire confiance à des intermédiaires. Les contrats intelligents et les preuves cryptographiques garantissent que toutes les parties peuvent interagir en toute confiance.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#086c81]/10 dark:bg-[#cbdde1]/10">
            <Icon name="eye" class="h-8 w-8 text-[#086c81] dark:text-[#cbdde1]" />
          </div>
          <h3 class="mt-4 text-xl font-semibold text-neutral-800 dark:text-neutral-200">
            Transparence Totale
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            Chaque transaction et étape de projet est visible sur la blockchain, offrant une transparence complète pour toutes les parties prenantes.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#086c81]/10 dark:bg-[#cbdde1]/10">
            <Icon name="globe" class="h-8 w-8 text-[#086c81] dark:text-[#cbdde1]" />
          </div>
          <h3 class="mt-4 text-xl font-semibold text-neutral-800 dark:text-neutral-200">
            Accès Global
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            Accessible de n'importe où dans le monde sans restrictions géographiques ou exigences bancaires traditionnelles.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#086c81]/10 dark:bg-[#cbdde1]/10">
            <Icon name="lightning" class="h-8 w-8 text-[#086c81] dark:text-[#cbdde1]" />
          </div>
          <h3 class="mt-4 text-xl font-semibold text-neutral-800 dark:text-neutral-200">
            Alimenté par Bitcoin
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            Exploite le réseau Bitcoin pour des transactions sécurisées et immuables et le stockage de valeur sans dépendre des systèmes financiers traditionnels.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#086c81]/10 dark:bg-[#cbdde1]/10">
            <Icon name="nostr" class="h-8 w-8 text-[#086c81] dark:text-[#cbdde1]" />
          </div>
          <h3 class="mt-4 text-xl font-semibold text-neutral-800 dark:text-neutral-200">
            Intégration Nostr
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            Utilise le protocole Nostr pour la communication décentralisée, garantissant des mises à jour de projet résistantes à la censure et l'interaction communautaire.
          </p>
        </div>
      </div>

      <!-- Mission Statement -->
      <div class="mt-16 text-center">
        <h2 class="text-2xl font-bold text-neutral-800 dark:text-neutral-200 mb-6">
          Notre Mission
        </h2>
        <p class="text-lg leading-relaxed text-neutral-700 dark:text-neutral-300 max-w-3xl mx-auto">
          Nous croyons en la démocratisation de l'accès au financement tout en éliminant le besoin de confiance entre les parties. En combinant la sécurité de Bitcoin avec les capacités de communication de Nostr, nous construisons l'avenir du financement de projets décentralisé où l'innovation peut prospérer sans barrières traditionnelles.
        </p>
      </div>

      <!-- Call to Action -->
      <div class="mt-16 text-center">
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/fr/welcome-to-docs/" 
            class="rounded-lg bg-[#086c81] px-8 py-4 text-base font-medium text-white hover:bg-[#022229] transition-colors duration-200"
          >
            Commencer
          </a>
          <a 
            href="/fr/contact" 
            class="rounded-lg border border-neutral-300 dark:border-neutral-600 px-8 py-4 text-base font-medium text-neutral-700 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors duration-200"
          >
            Nous Contacter
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
