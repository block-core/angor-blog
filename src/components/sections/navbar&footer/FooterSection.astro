---
// Import the necessary dependencies
import FooterSocialLink from "@components/ui/links/FooterSocialLink.astro";
import enStrings from "@utils/navigation.ts";
import frStrings from "@utils/fr/navigation.ts";
import arStrings from "@utils/ar/navigation.ts";
import faStrings from "@utils/fa/navigation.ts";
import Icon from "@components/ui/icons/Icon.astro";
import BrandLogo from "@components/BrandLogo.astro";
import { SITE } from "@data/constants";
import { generateNavLinks } from "@utils/linkManager";
import type { SupportedLocale } from "@utils/linkManager";
import nostrGif from "@/images/nostr.gif";

// Select the correct translation based on the page's lang prop:
const currentLocale = Astro.currentLocale || "en";
let strings = enStrings;
let sectionThreeTitle = "Stay up to date";
let sectionThreeContent = "Stay updated with the latest tools and exclusive deals.";
let crafted = "Crafted by";

// Generate professional navigation links using LinkManager
const navLinks = generateNavLinks(currentLocale as SupportedLocale);

switch (currentLocale) {
  case "fr":
    strings = frStrings;
    sectionThreeTitle = "Rester à jour";
    sectionThreeContent = "Restez informé des derniers outils et des offres exclusives.";
    crafted = "Fabriqué par";
    break;
  case "ar":
    strings = arStrings;
    sectionThreeTitle = "ابق على اطلاع";
    sectionThreeContent = "كن على اطلاع بأحدث الأدوات والعروض الحصرية.";
    crafted = "صنع بواسطة";
    break;
  case "fa":
    strings = faStrings;
    sectionThreeTitle = "به‌روز بمانید";
    sectionThreeContent = "از آخرین ابزارها و پیشنهادات ویژه مطلع باشید.";
    crafted = "ساخته شده توسط";
    break;
  default:
    strings = enStrings;
    sectionThreeTitle = "Stay up to date";
    sectionThreeContent = "Stay updated with the latest tools and exclusive deals.";
    crafted = "Crafted by";
}
---

<footer class="w-full bg-neutral-300 dark:bg-neutral-900">
  <div
    class="mx-auto w-full max-w-[85rem] px-4 py-10 sm:px-6 lg:px-16 lg:pt-20 2xl:max-w-(--breakpoint-2xl)"
  >
    <div class="grid grid-cols-2 gap-6 md:grid-cols-4 lg:grid-cols-5">
      <div class="col-span-full lg:col-span-1">
        <!-- Brand Logo -->
        <BrandLogo class="h-auto w-32" />
      </div>      <!-- An array of links for Product and Company sections -->
      {
        strings.footerLinks.map((section) => (
          <div class="col-span-1">
            <h3 class="font-bold text-neutral-800 dark:text-neutral-200">
              {section.section}
            </h3>
            <ul class="mt-3 grid space-y-3">
              {section.links.map((link) => {                
                // Use professional LinkManager for footer URLs
                const professionalUrl = (() => {
                  if (link.name === "Blog" || link.name === "المدونة" || link.name === "وبلاگ") {
                    return navLinks.blog;
                  } else if (link.name === "Contact" || link.name === "اتصل بنا" || link.name === "تماس با ما") {
                    return navLinks.contact;
                  } else if (link.name === "Nostr Articles" || link.name === "مقالات نوستر") {
                    return navLinks.nostrArticles;
                  } else if (link.name === "About us" || link.name === "À propos de nous" || link.name === "عنا" || link.name === "درباره ما") {
                    return currentLocale === "en" ? "/about" : `/${currentLocale}/about`;                  }
                  return link.url; // fallback to original URL
                })();

                return (
                  <li>
                    <a
                      href={professionalUrl}
                      class="inline-flex gap-x-2 rounded-lg text-neutral-600 outline-hidden ring-zinc-500 transition duration-300 hover:text-neutral-500 focus-visible:ring-3 dark:text-neutral-400 dark:ring-zinc-200 dark:hover:text-neutral-300 dark:focus:outline-hidden"
                    >
                      {link.name}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }

      <div class="col-span-2">
        <h3 class="font-bold text-neutral-800 dark:text-neutral-100 mb-2">
          {sectionThreeTitle}
        </h3>
        <div class="flex flex-row gap-3 items-center">
          <!-- RSS Dropdown Button -->
          <div class="relative flex items-center">
            <button
              class="rounded-lg bg-[#086c81] px-8 py-4 text-base font-medium text-white hover:bg-[#022229] transition-colors duration-200 flex items-center gap-2"
              type="button"
              onclick="const d=document.getElementById('rss-dropdown');d.classList.toggle('hidden');d.classList.toggle('open');"
              aria-haspopup="true"
              aria-expanded="false"
            >
 <svg
          class="h-5 w-5"
          version="1.1"
          id="Layer_1"
          xmlns="http://www.w3.org/2000/svg"
          xmlns:xlink="http://www.w3.org/1999/xlink"
          viewBox="0 0 512 512"
          xml:space="preserve"
        >
          <g>
            <path
              style="fill:#D5851F;"
              d="M149.047,437.393c0-40.825-33.206-74.039-74.02-74.039c-40.82,0-74.029,33.214-74.029,74.039
		c0,40.818,33.209,74.025,74.029,74.025C115.842,511.419,149.047,478.211,149.047,437.393z"
            ></path>
            <path
              style="fill:#D5851F;"
              d="M9.327,279.833c59.394,0,115.253,23.232,157.285,65.412c42.034,42.253,65.184,98.515,65.184,158.423
		c0,4.562,3.696,8.258,8.258,8.258h94.945c4.562,0,8.258-3.696,8.258-8.258c0-184.901-149.8-335.329-333.931-335.329
		c-4.562,0-8.258,3.696-8.258,8.258v94.976C1.069,276.135,4.767,279.833,9.327,279.833z"
            ></path>
            <path
              style="fill:#D5851F;"
              d="M9.456,0C4.895,0,1.198,3.696,1.198,8.258v94.959c0,4.562,3.696,8.258,8.258,8.258
		c215.106,0,390.109,175.969,390.109,392.266c0,4.562,3.696,8.258,8.258,8.258h94.92c4.562,0,8.258-3.696,8.258-8.258
		C511.002,225.977,286.009,0,9.456,0z"
            ></path>
          </g>
        </svg>
              <span>RSS</span>
              <svg class="w-4 h-4 ml-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div id="rss-dropdown" class="hidden absolute bottom-full left-0 mb-2 w-44 rounded-lg bg-white dark:bg-neutral-900 shadow-2xl border border-[#086c81] animate-fade-in z-20 overflow-hidden">
              <a href="/ar/rss.xml" class="block px-5 py-3 text-neutral-800 dark:text-neutral-100 hover:bg-[#086c81] hover:text-white dark:hover:bg-[#022229] font-medium transition-colors duration-200">RSS Arabic</a>
              <a href="/fa/rss.xml" class="block px-5 py-3 text-neutral-800 dark:text-neutral-100 hover:bg-[#086c81] hover:text-white dark:hover:bg-[#022229] font-medium transition-colors duration-200">RSS Persian</a>
              <a href="/fr/rss.xml" class="block px-5 py-3 text-neutral-800 dark:text-neutral-100 hover:bg-[#086c81] hover:text-white dark:hover:bg-[#022229] font-medium transition-colors duration-200">RSS French</a>
              <a href="/rss.xml" class="block px-5 py-3 text-neutral-800 dark:text-neutral-100 hover:bg-[#086c81] hover:text-white dark:hover:bg-[#022229] font-medium transition-colors duration-200">RSS English</a>
            </div>
          </div>
          <!-- Nostr Button -->
          <a
            href="https://angor.io/nostr/" target="_blank"
            class="rounded-lg bg-[#086c81] px-8 py-4 text-base font-medium text-white hover:bg-[#022229] transition-colors duration-200 flex items-center gap-2"
            rel="noopener"
          >
            <img src={nostrGif.src} alt="Nostr" class="w-6 h-6 rounded bg-transparent" style="object-fit:contain;" loading="lazy" />
            <span>Nostr</span>
          </a>
        </div>
        <script>
          // Close dropdown when clicking outside
          document.addEventListener('click', function(event) {
            const dropdown = document.getElementById('rss-dropdown');
            const button = dropdown?.previousElementSibling;
            const target = event.target as Node;
            if (
              dropdown &&
              !dropdown.contains(target) &&
              button &&
              !button.contains(target)
            ) {
              dropdown.classList.add('hidden');
              dropdown.classList.remove('open');
            }
          });
        </script>
      </div>
    </div>

    <div
      class="mt-9 grid gap-y-2 sm:mt-12 sm:flex sm:items-center sm:justify-between sm:gap-y-0"
    >
      <div class="flex items-center justify-between">
        <p class="text-sm text-neutral-600 dark:text-neutral-400">
          © <span id="current-year"></span> {SITE.title}. {crafted}
          <a
            class="rounded-lg font-medium underline underline-offset-2 outline-hidden ring-zinc-500 transition duration-300 hover:text-neutral-700 hover:decoration-dashed focus:outline-hidden focus-visible:ring-3 dark:ring-zinc-200 dark:hover:text-neutral-300"
            href="https://blog.angor.io"
            target="_blank"
            rel="noopener noreferrer">Angor</a
          >.
        </p>
      </div>

      <!-- Social Brands -->
      <div>

        <FooterSocialLink url={strings.socialLinks.x}
          ><Icon name="xFooter" /></FooterSocialLink
        >

        <FooterSocialLink url={strings.socialLinks.github}
          ><Icon name="githubFooter" />
        </FooterSocialLink>




      </div>
    </div>

    <script>
      const year = new Date().getFullYear();
      const element = document.getElementById("current-year");
      element!.innerText = year.toString();
    </script>
  </div>
</footer>
