---
// Import all required components and utilities
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import NostrAuthorBlogLarge from "@components/ui/avatars/NostrAuthorBlogLarge.astro";
import PrimaryCTA from "@components/ui/buttons/PrimaryCTA.astro";
import { getTranslation } from "@utils/translations";
import { generateBlogPostUrl } from "@utils/linkManager";
import type { SupportedLocale } from "@utils/linkManager";

const { blogEntry, recentBlogLocale = "" } = Astro.props;

interface Props {
  blogEntry: CollectionEntry<"blog">;
  recentBlogLocale?: string;
}

// Use fallback data initially - client-side will update if Nostr profile is available
const authorName = blogEntry.data.author;
const authorRole = blogEntry.data.role || "";

// Get localized "Read More" text
const readMoreText = getTranslation(recentBlogLocale || Astro.currentLocale, "read_more");

// Generate professional dynamic URL using LinkManager
const blogUrl = generateBlogPostUrl(blogEntry, recentBlogLocale as SupportedLocale);
---

<!-- Root container, which is divided into 2 grid column layout for larger screens -->
<div class="grid gap-8 sm:grid-cols-2 sm:items-center" data-nostr-recent-card data-nostr-pubkey={blogEntry.data.nostrPublicKey}>
  <!-- Container for the blog post's cover image -->
  <div class="sm:order-2">
    {blogEntry.data.cardImage && blogEntry.data.cardImage.src && blogEntry.data.cardImage.src.trim() !== "" && (
      <div class="relative rounded-lg pt-[50%] sm:pt-[100%]">
        <Image
          class="absolute start-0 top-0 size-full rounded-xl object-cover"
          src={blogEntry.data.cardImage}
          alt={blogEntry.data.cardImageAlt}
          draggable={"false"}
          loading={"eager"}          format={"avif"}
        />
      </div>
    )}
  </div>
  <!-- Container for the blog post's heading, author avatar, author's role, and read more button -->
  <div class="sm:order-1">    <!-- Blog title which is also a hyperlink to the blog detail page  -->
    <h2
      class="text-balance text-2xl font-bold tracking-tight text-neutral-800 dark:text-neutral-200 md:text-3xl lg:text-4xl lg:leading-tight xl:text-5xl xl:leading-tight"
    >
      <a
        class="outline-hidden ring-zinc-500 transition duration-300 hover:text-cyan-400 focus-visible:ring-3 dark:text-neutral-300 dark:ring-zinc-200 dark:hover:text-neutral-50 dark:focus:outline-hidden"
        href={blogUrl}
      >
        {blogEntry.data.description}
      </a>
    </h2>
    <!-- Container for the author's avatar and metadata -->
    <div class="mt-6 flex items-center sm:mt-10">
      <NostrAuthorBlogLarge blogEntry={blogEntry} lang={recentBlogLocale} />

      <div class="ms-3 sm:ms-4">
        <p class="font-bold text-neutral-800 dark:text-neutral-200 sm:mb-1" data-author-name>
          {authorName}
        </p>
        <p class="text-xs text-neutral-500" data-author-role>
          {authorRole}
        </p>
      </div>
    </div>    <!-- Read More button which is a link to the blog post detailed page -->
    <div class="mt-5">
      <PrimaryCTA
        url={blogUrl}
        title={readMoreText}
        data-astro-prefetch
      />
    </div>
  </div>
</div>

<script>
  import { getAuthorProfile } from "@utils/nostr";

  async function loadNostrRecentCardProfile() {
    const cards = document.querySelectorAll('[data-nostr-recent-card]');
    
    for (const card of cards) {
      const pubkey = card.getAttribute('data-nostr-pubkey');
      
      if (!pubkey) continue;
      
      try {
        const profile = await getAuthorProfile(pubkey);
        
        if (profile) {
          const authorNameEl = card.querySelector('[data-author-name]');
          const authorRoleEl = card.querySelector('[data-author-role]');
          
          if (profile.name || profile.display_name) {
            if (authorNameEl) {
              authorNameEl.textContent = profile.display_name || profile.name || '';
            }
          }
          
          if (profile.about && authorRoleEl) {
            authorRoleEl.textContent = profile.about;
          }
        }
      } catch (error) {
        console.error('Error loading Nostr profile for recent card:', error);
      }
    }
  }

  // Load profiles when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadNostrRecentCardProfile);
  } else {
    loadNostrRecentCardProfile();
  }
</script>
